+class WirelessAssociationScreen(ModalScreen[WirelessAssociationRequest | None]):
+    """Seleção explícita do Node responsável por um sensor BLE descoberto."""
+
+    BINDINGS = [Binding("escape", "cancel", "Cancelar", show=False)]
+
+    def __init__(self, state: AppState) -> None:
+        super().__init__()
+        self.state = state
+
+    def _options(self) -> list[Option]:
+        options: list[Option] = []
+        associated_uuids: set[str] = set()
+
+        for node_id, node in sorted(self.state.nodes.items()):
+            for child_id, sensor in sorted(node.sensors.items()):
+                if not sensor.wireless_uuid:
+                    continue
+                associated_uuids.add(sensor.wireless_uuid)
+                options.append(
+                    Option(
+                        f"ASSOC {sensor.logical_id}  {sensor.association_state}  "
+                        f"{sensor.profile_id or 'UNKNOWN'}  {sensor.wireless_uuid}",
+                        id=f"unbind:{node_id}:{child_id}:{sensor.wireless_uuid}",
+                    )
+                )
+
+        observations: dict[str, list[tuple[int, int, str]]] = {}
+        for node_id, node in self.state.nodes.items():
+            for candidate in node.wireless_candidates.values():
+                observations.setdefault(candidate.wireless_uuid, []).append(
+                    (node_id, candidate.rssi_dbm, candidate.profile_id)
+                )
+
+        for uuid, rows in sorted(observations.items()):
+            if uuid in associated_uuids:
+                continue
+            rows.sort(key=lambda item: item[1], reverse=True)
+            for index, (node_id, rssi, profile) in enumerate(rows):
+                recommended = "★" if index == 0 else " "
+                options.append(
+                    Option(
+                        f"{recommended} {uuid}  {profile}  Node {node_id:02d}  RSSI={rssi} dBm",
+                        id=f"bind:{node_id}:{uuid}",
+                    )
+                )
+
+        if not options:
+            options.append(Option("Nenhum candidato ou associação disponível", id="__empty__", disabled=True))
+        return options
+
+    def compose(self) -> ComposeResult:
+        with Vertical(id="wireless-association-dialog", classes="modal wide-modal"):
+            yield Static("ASSOCIAÇÃO WIRELESS", classes="modal-title")
+            yield Static(
+                "★ indica o Node com melhor RSSI para cada UUID. "
+                "Selecione uma observação para associar ou uma associação existente para remover.",
+                classes="modal-hint",
+            )
+            yield OptionList(*self._options(), id="wireless-association-list")
+            with Horizontal(classes="modal-buttons"):
+                yield Button("Executar", id="wireless-association-apply", variant="primary")
+                yield Button("Cancelar", id="wireless-association-cancel")
+
+    def on_mount(self) -> None:
+        widget = self.query_one("#wireless-association-list", OptionList)
+        for index in range(widget.option_count):
+            if not widget.get_option_at_index(index).disabled:
+                widget.highlighted = index
+                break
+        widget.focus()
+
+    def _selected_request(self) -> WirelessAssociationRequest | None:
+        widget = self.query_one("#wireless-association-list", OptionList)
+        if widget.highlighted is None:
+            return None
+        option = widget.get_option_at_index(widget.highlighted)
+        if option.disabled or not option.id or option.id == "__empty__":
+            return None
+        parts = str(option.id).split(":")
+        if parts[0] == "bind" and len(parts) == 3:
+            return WirelessAssociationRequest("BIND", int(parts[1]), parts[2])
+        if parts[0] == "unbind" and len(parts) == 4:
+            return WirelessAssociationRequest("UNBIND", int(parts[1]), parts[3])
+        return None
+
+    @on(OptionList.OptionSelected, "#wireless-association-list")
+    def _option_selected(self, event: OptionList.OptionSelected) -> None:
+        request = self._selected_request()
+        if request:
+            self.dismiss(request)
+
+    @on(Button.Pressed, "#wireless-association-apply")
+    def _apply(self) -> None:
+        request = self._selected_request()
+        if request:
+            self.dismiss(request)
+        else:
+            self.notify("Selecione um candidato ou associação", severity="warning")
+
+    @on(Button.Pressed, "#wireless-association-cancel")
+    def _cancel_button(self) -> None:
+        self.dismiss(None)
+
+    def action_cancel(self) -> None:
+        self.dismiss(None)
+
+
 class ConfigScreen(ModalScreen[ConfigRequest | None]):
