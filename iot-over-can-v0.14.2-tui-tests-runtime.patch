+def _direct_test_app(fake_fw: FakeFirmware) -> PicoTuiApp:
+    """App direta para testes funcionais, sem exercitar a política de segurança.
+
+    Segurança/autenticação possuem testes próprios. Aqui o objetivo é validar
+    navegação, comandos, DTC, telemetria e FFT sem depender de YubiKey/token.
+    """
+    app = PicoTuiApp(
+        port=fake_fw.slave_name,
+        mode="sensor",
+        enable_file_log=False,
+        security_mode="off",
+    )
+    # Segurança/autenticação têm cobertura própria. O firmware falso deste
+    # módulo testa apenas os fluxos funcionais da TUI, portanto desativa a
+    # exigência de AUTH no gerenciador desta instância de teste.
+    app.security.command_requires_auth = lambda command: False  # type: ignore[method-assign]
+    return app
+
+
