/* iot-over-can, paleta "Aço industrial" (ver palette.py).
 *
 * Disposição responsiva, controlada por classes no App:
 *   bp-narrow  < 60 colunas   uma coluna, seções sem bordas laterais
 *   bp-medium  60 a 99        uma coluna
 *   bp-wide    >= 100         duas colunas
 *   bp-short   < 30 linhas    menos espaçamento vertical, faixa de estado compacta
 */

$bg-root: #1F2429;
$bg-panel: #272D33;
$bg-raised: #313840;
$bg-widget: #1B2025;
$bg-selected: #2E4A66;
$bg-highlight-idle: #2A3640;
$border-soft: #46505A;
$border-strong: #5F6B77;
$text-primary: #E3E7EB;
$text-secondary: #B7C0C8;
$text-muted: #8E99A3;
$text-dim: #6B7680;
$text-inverse: #15191D;
$accent-focus: #5B9BE0;
$accent-action: #3D7CC9;
$state-warning: #E8A317;
$band-critical: #B3261E;
$band-offline: #3A424B;

Screen {
    background: $bg-root;
    color: $text-primary;
    layers: base overlay;
}

/* ---------------------------------------------------------------- faixa de estado */

#status-band {
    dock: top;
    height: auto;
    padding: 0 1;
    background: $bg-raised;
    color: $text-primary;
}

#status-band.band-normal {
    background: $bg-raised;
    color: $text-primary;
}

#status-band.band-attention {
    background: $state-warning;
    color: $text-inverse;
}

#status-band.band-critical {
    background: $band-critical;
    color: #FFFFFF;
}

#status-band.band-offline {
    background: $band-offline;
    color: $text-primary;
}

#breadcrumb {
    height: auto;
    padding: 1 1 0 1;
}

.bp-short #breadcrumb, .bp-narrow #breadcrumb {
    padding: 0 1;
}

/* ---------------------------------------------------------------- barra de teclas */

#key-bar {
    dock: bottom;
    height: auto;
    padding: 0 1;
    background: $bg-panel;
    border-top: solid $border-soft;
}

/* ---------------------------------------------------------------- corpo e seções */

.body {
    height: 1fr;
    padding: 1 1 0 1;
    scrollbar-color: $border-strong;
    scrollbar-color-hover: $accent-focus;
    scrollbar-background: $bg-root;
    scrollbar-size-vertical: 1;
}

.bp-short .body {
    padding: 0 1;
}

.columns {
    layout: vertical;
    height: auto;
}

.column {
    width: 1fr;
    height: auto;
}

.bp-wide .columns {
    layout: horizontal;
}

.bp-wide .column-main {
    width: 3fr;
}

.bp-wide .column-side {
    width: 2fr;
}

.bp-wide .columns > .column {
    margin-right: 1;
}

.bp-wide .columns > .column:last-of-type {
    margin-right: 0;
}

.section {
    height: auto;
    background: $bg-panel;
    border: round $border-soft;
    border-title-color: $text-secondary;
    border-title-style: bold;
    padding: 0 1;
    margin-bottom: 1;
}

.section:focus-within {
    border: round $accent-focus;
    border-title-color: $accent-focus;
}

/* Telas estreitas: só a borda superior (com o título) para ganhar colunas. */
.bp-narrow .section {
    border: none;
    border-top: round $border-soft;
    padding: 0;
}

.bp-narrow .section:focus-within {
    border: none;
    border-top: round $accent-focus;
}

.bp-narrow .body {
    padding: 0 1;
}

.bp-short .section {
    margin-bottom: 0;
}

.subfields {
    margin-top: 1;
}

.hint {
    color: $text-muted;
    height: auto;
}

/* Seções marcadas com .grow ocupam o espaço que sobra na coluna (só em telas largas). */
.bp-wide .grow {
    height: 1fr;
    min-height: 8;
}

/* ---------------------------------------------------------------- tela inicial */

.bp-wide #home-body {
    overflow-y: auto;
}

.bp-wide #home-columns {
    height: 1fr;
    min-height: 12;
}

.bp-wide #home-main {
    height: 1fr;
}

.bp-wide #sec-equipment {
    height: 1fr;
    min-height: 8;
}

#sec-home-messages {
    height: 10;
}

.bp-short #sec-home-messages {
    height: 6;
}

#home-message-log {
    height: 1fr;
}

/* ---------------------------------------------------------------- listas */

OptionList {
    height: auto;
    max-height: 100%;
    background: $bg-panel;
    color: $text-primary;
    border: none;
    padding: 0;
    scrollbar-size-vertical: 1;
    scrollbar-color: $border-strong;
    scrollbar-background: $bg-panel;
}

OptionList:focus {
    border: none;
}

OptionList > .option-list--option-highlighted {
    background: $bg-highlight-idle;
}

OptionList:focus > .option-list--option-highlighted {
    background: $bg-selected;
}

OptionList > .option-list--option-disabled {
    color: $text-muted;
}

.bp-wide #equipment-list {
    height: 1fr;
}

.bp-wide #cmd-actions {
    height: 1fr;
}

.bp-wide #sec-actions {
    height: 1fr;
    min-height: 8;
}

.bp-wide #command-body > .columns {
    height: 1fr;
    min-height: 14;
}

.bp-wide #command-body .column-main {
    height: 1fr;
}

#attention-list {
    max-height: 12;
}

/* ---------------------------------------------------------------- campos e entradas */

Input {
    background: $bg-widget;
    color: $text-primary;
    border: tall $border-soft;
}

Input:focus {
    border: tall $accent-focus;
}

Select {
    width: 100%;
}

Label {
    color: $text-muted;
    margin-top: 1;
}

.trend-label {
    margin-top: 1;
}

.trend {
    height: 2;
    margin-bottom: 1;
}

.trend > .sparkline--max-color {
    color: $accent-focus;
}

.trend > .sparkline--min-color {
    color: #36506B;
}

/* ---------------------------------------------------------------- mensagens */

MessageLog {
    height: 1fr;
    background: $bg-widget;
    color: $text-secondary;
    scrollbar-size-vertical: 1;
    scrollbar-color: $border-strong;
    scrollbar-background: $bg-widget;
}

#sec-messages {
    height: 1fr;
}

#messages-log {
    height: 1fr;
}

/* ---------------------------------------------------------------- espectro */

#fft-ascii {
    height: auto;
    color: $accent-focus;
}

/* ---------------------------------------------------------------- botões */

Button {
    background: $bg-raised;
    color: $text-primary;
    border: tall $border-strong;
    margin-right: 1;
    min-width: 10;
}

Button:focus {
    border: tall $accent-focus;
    text-style: bold;
}

Button.-primary {
    background: $accent-action;
    color: #FFFFFF;
    border: tall $accent-action;
}

Button.-error {
    background: $band-critical;
    color: #FFFFFF;
    border: tall $band-critical;
}

Button.-primary:focus, Button.-error:focus {
    border: tall #FFFFFF;
}

/* ---------------------------------------------------------------- diálogos */

ConnectScreen, ConfirmScreen, ParameterScreen, ConfigScreen, TargetScreen, WirelessNodeScreen {
    align: center middle;
    background: rgba(10, 12, 14, 0.75);
}

.dialog {
    width: 72;
    max-width: 100%;
    height: auto;
    max-height: 100%;
    background: $bg-raised;
    border: round $border-strong;
    padding: 1 2;
}

.bp-narrow .dialog {
    width: 100%;
    padding: 0 1;
    border: none;
    border-top: round $border-strong;
}

.dialog-title {
    text-style: bold;
    color: $text-primary;
    height: auto;
}

.dialog-hint {
    color: $text-muted;
    height: auto;
    margin-top: 1;
}

.dialog-buttons {
    height: auto;
    margin-top: 1;
}

/* Botões sempre visíveis: ficam presos ao rodapé do diálogo, que rola por cima. */
.dialog > .dialog-buttons {
    dock: bottom;
    background: $bg-raised;
    padding-top: 1;
    margin-top: 0;
}

.dialog Label {
    margin-top: 1;
}

/* Telas baixas (até 29 linhas): formulários compactos, campos de uma linha. */
.bp-short .dialog {
    padding: 0 1;
}

.bp-short .dialog Label {
    margin-top: 0;
}

.bp-short .dialog-hint {
    margin-top: 0;
}

.bp-short .dialog Input {
    height: 1;
    border: none;
    padding: 0 1;
    background: $bg-widget;
}

.bp-short .dialog Input:focus {
    background: $bg-selected;
    border: none;
}

.bp-short .dialog > .dialog-buttons {
    padding-top: 0;
}

#confirm-message {
    margin-top: 1;
    height: auto;
}

#port-list, #parameter-choice, #target-list {
    max-height: 12;
    background: $bg-widget;
}

#parameter-error, #cfg-error {
    height: auto;
}

/* Toasts (notificações) */
Toast {
    background: $bg-raised;
    color: $text-primary;
}

#cmd-target {
    margin-bottom: 1;
}

/* ---------------------------------------------------------------- sensores sem fio */

#wireless-available, #wireless-associated {
    min-height: 6;
}

.bp-wide #sec-wireless-available, .bp-wide #sec-wireless-associated {
    height: 1fr;
    min-height: 10;
}

.bp-wide #wireless-body > .columns {
    height: 1fr;
    min-height: 14;
}

#wireless-node-list {
    max-height: 12;
    background: $bg-widget;
}

/* ---------------------------------------------------------------- métricas e ensaios */

#exp-list {
    max-height: 18;
    min-height: 6;
}

#exp-timeline {
    margin-top: 1;
}

#choice-list {
    max-height: 12;
    background: $bg-widget;
}
